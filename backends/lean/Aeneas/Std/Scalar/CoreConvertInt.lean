/-! ## Blanket impls and `AsRef` -/

/-- `impl<T, U: Into<T>> TryFrom<U> for T { type Error = Infallible; ... }` -/
@[expose, rust_fun "core::convert::{core::convert::TryFrom<@T, @U, !>}::try_from"]
def core.convert.TryFromTUNever.Blanket.try_from {T : Type _} {U : Type _}
    (IntoInst : core.convert.Into U T) (x : U) : Result (core.result.Result T Never) := do
  let t ← IntoInst.into x
  ok (.Ok t)

@[expose, rust_fun "core::convert::{core::convert::AsRef<&'0 @T, @U>}::as_ref"]
def Shared0T.Insts.CoreConvertAsRef.as_ref {T : Type _} {U : Type _}
    (AsRefInst : core.convert.AsRef T U) (x : T) : Result U :=
  AsRefInst.as_ref x

@[expose, rust_fun "core::convert::{core::convert::AsRef<[@T], [@T]>}::as_ref"]
def Slice.Insts.CoreConvertAsRefSlice.as_ref {T : Type _} (x : Slice T) : Result (Slice T) :=
  ok x
/-- `#[derive(Debug)] pub struct TryFromIntError(pub(crate) ());` -/
@[expose, rust_fun "core::num::error::{core::fmt::Debug<core::num::error::TryFromIntError>}::fmt"]
def core.num.error.TryFromIntError.Insts.CoreFmtDebug.fmt (_ : core.num.error.TryFromIntError)
    (f : core.fmt.Formatter) : core.fmt.FmtResult :=
  f.debugTuple "TryFromIntError" [core.fmt.DebugUnit.fmt ()]


end Aeneas.Std
