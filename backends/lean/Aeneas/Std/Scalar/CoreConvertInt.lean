module
public import Aeneas.Std.Scalar.CoreConvertNum
public import Aeneas.Std.Core.Fmt
public import Aeneas.Std.Core.Convert
public meta import Lean.Elab.Command
public section

/-!
# Integer conversions of `core::convert::num`

`From` between integer types of different signedness (lossless widenings) and `TryFrom` between
all integer types (`Err(TryFromIntError(()))` iff the value is out of the target range), plus the
blanket `TryFrom<U> for T where U: Into<T>` and the `AsRef` impls of `core::convert`.

The declarations are generated by the `int_from`/`int_try_from` commands below, which produce the
Lean name and the Rust name pattern Aeneas uses for each impl.
-/

namespace Aeneas.Std

open Result

/-- Conversion of an integer value to an unsigned type, failing if it is out of range. -/
@[expose] def core.num.tryIntToU (tgt : UScalarTy) (v : Int) :
    Result (core.result.Result (UScalar tgt) core.num.error.TryFromIntError) :=
  if 0 ≤ v ∧ v < (2 ^ tgt.numBits : Nat) then ok (.Ok ⟨BitVec.ofInt _ v⟩) else ok (.Err ())

/-- Conversion of an integer value to a signed type, failing if it is out of range. -/
@[expose] def core.num.tryIntToI (tgt : IScalarTy) (v : Int) :
    Result (core.result.Result (IScalar tgt) core.num.error.TryFromIntError) :=
  if -((2 ^ (tgt.numBits - 1) : Nat) : Int) ≤ v ∧ v < (2 ^ (tgt.numBits - 1) : Nat) then
    ok (.Ok ⟨BitVec.ofInt _ v⟩)
  else ok (.Err ())

open Lean in
/-- `int_try_from [ptr] TGT SRC`: `impl TryFrom<SRC> for TGT` (the `ptr` flag selects the
    `ptr_try_from_impls` module, used by `core` for the pairs involving `usize`/`isize`). -/
syntax (name := intTryFrom) "int_try_from " (&"ptr")? ident ident : command

open Lean in
/-- `int_from TGT SRC`: `impl From<SRC> for TGT`. -/
syntax (name := intFrom) "int_from " ident ident : command

open Lean Elab Command in
@[command_elab intTryFrom]
meta def elabIntTryFrom : CommandElab := fun stx => do
  let isPtr := !stx[1].isNone
  let tgt := stx[2].getId.toString
  let src := stx[3].getId.toString
  let modl := if isPtr then "core::convert::num::ptr_try_from_impls" else "core::convert::num"
  let pat := Syntax.mkStrLit
    s!"{modl}::\{core::convert::TryFrom<{tgt.toLower}, {src.toLower}, core::num::error::TryFromIntError>}::try_from"
  let name := mkIdent (.str (.str (.str (.mkSimple tgt) "Insts")
    s!"CoreConvertTryFrom{src}TryFromIntError") "try_from")
  let tgtId := mkIdent (.mkSimple tgt)
  let srcId := mkIdent (.mkSimple src)
  let body ← if tgt.startsWith "U" then
      `(core.num.tryIntToU $(mkIdent (.str `UScalarTy tgt)) (x.val : Int))
    else `(core.num.tryIntToI $(mkIdent (.str `IScalarTy tgt)) (x.val : Int))
  elabCommand (← `(@[expose, rust_fun $pat] def $name (x : $srcId) :
      Result (core.result.Result $tgtId core.num.error.TryFromIntError) := $body))

open Lean Elab Command in
@[command_elab intFrom]
meta def elabIntFrom : CommandElab := fun stx => do
  let tgt := stx[1].getId.toString
  let src := stx[2].getId.toString
  let pat := Syntax.mkStrLit
    s!"core::convert::num::\{core::convert::From<{tgt.toLower}, {src.toLower}>}::from"
  let name := mkIdent (.str (.str (.str (.mkSimple tgt) "Insts") s!"CoreConvertFrom{src}") "from")
  let tgtId := mkIdent (.mkSimple tgt)
  let srcId := mkIdent (.mkSimple src)
  elabCommand (← `(@[expose, rust_fun $pat] def $name (x : $srcId) : Result $tgtId :=
      ok ⟨BitVec.ofInt _ (x.val : Int)⟩))

/-! ## `From` (unsigned to wider signed) -/

int_from I16 U8
int_from I32 U8
int_from I64 U8
int_from I128 U8
int_from I32 U16
int_from I64 U16
