def test_sort_unstable : Result Unit := do
  let (s, to_slice_mut_back) ←
    lift (Array.to_slice_mut
      (Array.make 6#usize [ 5#u32, 1#u32, 4#u32, 1#u32, 3#u32, 2#u32 ]))
  let s1 ← core.slice.Slice.sort_unstable core.cmp.OrdU32 s
  let v := to_slice_mut_back s1
  let i ← Array.index_usize v 0#usize
  massert (i = 1#u32)
  let i1 ← Array.index_usize v 1#usize
  massert (i1 = 1#u32)
  let i2 ← Array.index_usize v 2#usize
  massert (i2 = 2#u32)
  let i3 ← Array.index_usize v 3#usize
  massert (i3 = 3#u32)
  let i4 ← Array.index_usize v 4#usize
  massert (i4 = 4#u32)
  let i5 ← Array.index_usize v 5#usize
  massert (i5 = 5#u32)
  let (s2, to_slice_mut_back1) ←
    lift (Array.to_slice_mut
      (Array.make 4#usize [
        (3#u32, 1#u32), (1#u32, 2#u32), (2#u32, 3#u32), (0#u32, 4#u32)
        ]))
  let s3 ←
    core.slice.Slice.sort_unstable_by_key
      test_sort_unstable.closure.Insts.CoreOpsFunctionFnMutTupleShared0PairU32U32U32
      core.cmp.OrdU32 s2 ()
  let p := to_slice_mut_back1 s3
  let (_, i6) ← Array.index_usize p 0#usize
  massert (i6 = 4#u32)
  let (_, i7) ← Array.index_usize p 1#usize
  massert (i7 = 2#u32)
  let (_, i8) ← Array.index_usize p 2#usize
  massert (i8 = 3#u32)
  let (_, i9) ← Array.index_usize p 3#usize
  massert (i9 = 1#u32)
  ok ()

/- Unit test for [clifv_std_slice::test_sort_unstable] -/
#guard (test_sort_unstable).reducesTo ()

