def test_range_inclusive_index : Result Unit := do
  let ri ← core.ops.range.RangeInclusive.new 1#usize 3#usize
  let s ←
    core.array.Array.index (core.ops.index.IndexSlice
      (core.ops.range.RangeInclusiveUsize.Insts.CoreSliceIndexSliceIndexSliceSlice
      Std.U32)) (Array.make 5#usize [ 1#u32, 2#u32, 3#u32, 4#u32, 5#u32 ]) ri
  let i := Slice.len s
  massert (i = 3#usize)
  let i1 ← Slice.index_usize s 0#usize
  massert (i1 = 2#u32)
  let i2 ← Slice.index_usize s 2#usize
  massert (i2 = 4#u32)
  let s1 ←
    lift (Array.to_slice
      (Array.make 5#usize [ 1#u32, 2#u32, 3#u32, 4#u32, 5#u32 ]))
  let ri1 ← core.ops.range.RangeInclusive.new 2#usize 4#usize
  let o ←
    core.slice.Slice.get
      (core.ops.range.RangeInclusiveUsize.Insts.CoreSliceIndexSliceIndexSliceSlice
      Std.U32) s1 ri1
  let b := core.option.Option.is_some o
  massert b
  let s2 ←
    lift (Array.to_slice
      (Array.make 5#usize [ 1#u32, 2#u32, 3#u32, 4#u32, 5#u32 ]))
  let ri2 ← core.ops.range.RangeInclusive.new 3#usize 5#usize
  let o1 ←
    core.slice.Slice.get
      (core.ops.range.RangeInclusiveUsize.Insts.CoreSliceIndexSliceIndexSliceSlice
      Std.U32) s2 ri2
  let b1 := core.option.Option.is_none o1
  massert b1
  let w := Array.repeat 4#usize 0#u32
  let ri3 ← core.ops.range.RangeInclusive.new 1#usize 2#usize
  let (s3, index_mut_back) ←
    core.array.Array.index_mut (core.ops.index.IndexMutSlice
      (core.ops.range.RangeInclusiveUsize.Insts.CoreSliceIndexSliceIndexSliceSlice
      Std.U32)) w ri3
  let s4 ←
    core.array.Array.index (core.ops.index.IndexSlice
      (core.slice.index.SliceIndexRangeToUsizeSlice Std.U32))
      (Array.make 5#usize [ 1#u32, 2#u32, 3#u32, 4#u32, 5#u32 ])
      { «end» := 2#usize }
  let s5 ← core.slice.Slice.clone_from_slice core.clone.CloneU32 s3 s4
  let w1 := index_mut_back s5
  let i3 ← Array.index_usize w1 1#usize
  massert (i3 = 1#u32)
  let i4 ← Array.index_usize w1 2#usize
  massert (i4 = 2#u32)
  let i5 ← Array.index_usize w1 3#usize
  massert (i5 = 0#u32)
  ok ()

